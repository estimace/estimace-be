{
  "name": "estimace-be",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "db:migrate:make": "node --import tsx/esm ./node_modules/.bin/knex migrate:make",
    "db:migrate:latest": "node --import tsx/esm ./node_modules/.bin/knex migrate:latest",
    "db:migrate:rollback": "node --import tsx/esm ./node_modules/.bin/knex migrate:rollback",
    "test": "vitest --run",
    "test:watch": "vitest -w",
    "test:coverage": "yarn vitest  --run --coverage"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "knex": "^3.1.0",
    "md5": "^2.3.0",
    "morgan": "^1.12.1",
    "nanoid": "^5.1.16",
    "pg": "^8.16.3",
    "tsx": "^4.21.0",
    "uuid": "^11.1.1",
    "validator": "^13.15.23",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/md5": "^2.3.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "@types/validator": "^13.15.10",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.12",
    "supertest": "^7.3.2",
    "superwstest": "^2.1.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "resolutions": {
    "path-to-regexp": "0.1.13"
  }
}
